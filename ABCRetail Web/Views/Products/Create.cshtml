@model ABCRetail.Models.Product

<h1>Add Product</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    <label>Name<input asp-for="Name" /></label>

    <label>Description<input asp-for="Description" /></label>

    <label>Price<input asp-for="Price" type="number" step="0.01" /></label>

    <div>
        <label for="imageUpload">Choose an Image:</label>
        <input type="file"
               id="imageUpload"
               name="image"
               accept="image/*" />
    </div>

    <button type="submit">
        Add Product
    </button>
    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Products
    </a>
</form>