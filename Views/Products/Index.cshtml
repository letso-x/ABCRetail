@model IEnumerable<ABCRetail.Models.Product>

<h1>Product List</h1>


<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Image</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            
            <tr>
                <td>@product.Name</td>

                <td>@product.Description</td>

                <td>R @product.Price</td>

               <td> @if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    <img src="@product.ImageUrl"
                         alt="@product.Name"
                         width="200" />
                }
                </td>
            </tr>

            
        }
    </tbody>
</table>

<a asp-action="Create" class="btn btn-primary">Add New Product</a>
