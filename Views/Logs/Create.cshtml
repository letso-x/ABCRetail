@{
    ViewData["Title"] = "Create Log File";
}

<h1>Create Log File</h1>

@if (ViewBag.Message != null)
{
    <div>
        @ViewBag.Message
    </div>
}

<form asp-action="Create" method="post">

    <div>
        <label for="fileName">File Name</label>
        <input type="text"
               id="fileName"
               name="fileName"
               placeholder="CustomerLog.txt" />
    </div>

    <br />

    <div>
        <label for="content">Log Content</label>
        <textarea id="content"
                  name="content"
                  rows="10"
                  cols="60"
                  placeholder="Enter log information..."></textarea>
    </div>

    <br />

    <button type="submit">
        Create Log File
    </button>

</form>