@model ABCRetail.Models.Customer

<h1>Add Customer</h1>

<form asp-action="Create" method="post">

    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Email</label>
        <input asp-for="Email" />
    </div>

    <div>
        <label>Phone</label>
        <input asp-for="Phone" />
    </div>

    <button type="submit">Add Customer</button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Customers
    </a>

</form>